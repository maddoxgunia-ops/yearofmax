---
import { formatDate } from '../lib/entries';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  recent?: boolean;
  status?: string;
}

const { href, title, summary, date, recent = false, status } = Astro.props;
---

<li class="entry" class:list={{ 'is-recent': recent }} data-entry>
  <a class="entry__link" href={href}>
    <time class="entry__date label" datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="entry__stem" aria-hidden="true"></span>
    <span class="entry__text">
      <span class="entry__title heading">{title}</span>
      <span class="entry__summary">{summary}</span>
      {status && <span class="entry__status label">{status}</span>}
    </span>
  </a>
</li>

<style>
  .entry {
    border-top: var(--hairline) solid var(--rule);
  }

  .entry__link {
    display: grid;
    grid-template-columns: minmax(9ch, auto) var(--hairline) 1fr;
    column-gap: 1.75rem;
    align-items: stretch;
    padding: 1.75rem 0;
  }

  .entry__date {
    color: var(--graphite);
    padding-top: 0.35em;
    transition: color 420ms ease;
  }

  /* The 1px vertical stem. */
  .entry__stem {
    background: var(--rule);
    transition: background-color 420ms ease;
  }

  .entry__text {
    display: block;
    max-width: var(--measure);
  }

  .entry__title {
    display: block;
    color: var(--ink);
    transition: color 420ms ease;
  }

  .entry__summary {
    display: block;
    margin-top: 0.4rem;
    color: var(--graphite);
  }

  .entry__status {
    display: block;
    margin-top: 0.75rem;
  }

  /* Signal is reserved for "now": entries inside the recency window. */
  .entry.is-recent .entry__stem {
    background: var(--signal);
  }

  .entry.is-recent .entry__date {
    color: var(--signal);
  }

  /* Pre-animation state, declared only when motion is running. Without JS or
     under reduced motion the resting state above is already the final state. */
  :global(html[data-motion='on']) .entry:not(.is-lit) .entry__title {
    color: var(--graphite);
  }

  :global(html[data-motion='on']) .entry:not(.is-lit) .entry__stem {
    background: var(--rule);
  }

  :global(html[data-motion='on']) .entry:not(.is-lit) .entry__date {
    color: var(--graphite);
  }

  @media (max-width: 40rem) {
    .entry__link {
      grid-template-columns: var(--hairline) 1fr;
      column-gap: 1.25rem;
      row-gap: 0.6rem;
    }

    .entry__date {
      grid-column: 2;
      padding-top: 0;
    }

    .entry__stem {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    .entry__text {
      grid-column: 2;
    }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const THRESHOLD = 0.88;

  function setup(): void {
    const rows = document.querySelectorAll<HTMLElement>('[data-entry]');

    for (const row of rows) {
      // Rows already on screen at load light immediately; the CSS transition
      // still runs, so the first paint reveals rather than snapping.
      if (row.getBoundingClientRect().top < window.innerHeight * THRESHOLD) {
        row.classList.add('is-lit');
        continue;
      }

      ScrollTrigger.create({
        trigger: row,
        start: `top ${THRESHOLD * 100}%`,
        once: true,
        onEnter: () => {
          row.classList.add('is-lit');
        },
      });
    }
  }

  document.addEventListener('motion:ready', setup);
</script>
