---
import { formatDate } from '../lib/entries';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  status: string;
  cover?: string;
  recent?: boolean;
}

const { href, title, summary, date, status, cover, recent = false } = Astro.props;

// Only render the plate once the file actually exists, so a missing asset
// never shows as a broken image.
const { existsSync } = await import('node:fs');
const hasCover = !!cover && existsSync(`public${cover}`);
---

<li class="block" class:list={{ 'is-recent': recent }} data-entry>
  <a class="block__link" href={href}>
    <time class="block__date label" datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="block__stem" aria-hidden="true"></span>

    <span class="block__body">
      {hasCover && (
        <span class="block__cover">
          <img src={cover} alt="" loading="lazy" decoding="async" />
        </span>
      )}
      <span class="block__title heading">{title}</span>
      <span class="block__summary">{summary}</span>
      <span class="block__status label">{status}</span>
    </span>
  </a>
</li>

<style>
  .block {
    border-top: var(--hairline) solid var(--rule);
  }

  .block__link {
    display: grid;
    grid-template-columns: minmax(9ch, auto) var(--hairline) 1fr;
    column-gap: 1.75rem;
    align-items: stretch;
    padding: 2rem 0 2.25rem;
  }

  .block__date {
    color: var(--graphite);
    padding-top: 0.35em;
    transition: color 420ms ease;
  }

  .block__stem {
    background: var(--rule);
    transition: background-color 420ms ease;
  }

  .block__body {
    display: block;
    max-width: 52rem;
  }

  .block__cover {
    display: block;
    margin-bottom: 1.5rem;
    background: var(--rule);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .block__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 420ms ease, transform 620ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .block:hover .block__cover img {
    filter: saturate(1);
    transform: scale(1.012);
  }

  .block__title {
    display: block;
    color: var(--ink);
    transition: color 420ms ease;
  }

  .block__summary {
    display: block;
    margin-top: 0.4rem;
    color: var(--graphite);
    max-width: var(--measure);
  }

  .block__status {
    display: block;
    margin-top: 0.9rem;
  }

  .block.is-recent .block__stem {
    background: var(--signal);
  }

  .block.is-recent .block__date {
    color: var(--signal);
  }

  :global(html[data-motion='on']) .block:not(.is-lit) .block__title {
    color: var(--graphite);
  }

  :global(html[data-motion='on']) .block:not(.is-lit) .block__stem {
    background: var(--rule);
  }

  :global(html[data-motion='on']) .block:not(.is-lit) .block__date {
    color: var(--graphite);
  }

  @media (max-width: 40rem) {
    .block__link {
      grid-template-columns: var(--hairline) 1fr;
      column-gap: 1.25rem;
      row-gap: 0.6rem;
    }

    .block__date {
      grid-column: 2;
      padding-top: 0;
    }

    .block__stem {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    .block__body {
      grid-column: 2;
    }
  }
</style>
