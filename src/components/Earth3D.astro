---
// WebGL globe, sky and planets. Everything renders on the client: sun angle,
// rotation and planet positions all depend on the date the timeline is on.
---

<div class="globe" data-globe aria-hidden="true"></div>
<span class="body-name label" data-body-name hidden></span>

<style>
  .globe {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .globe canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .body-name {
    position: fixed;
    z-index: 3;
    color: var(--ink);
    pointer-events: none;
    white-space: nowrap;
    transform: translate(12px, -50%);
    text-shadow: 0 0 10px rgb(0 0 0 / 0.9);
  }
</style>

<script>
  import {
    AdditiveBlending, BackSide, BufferGeometry, Float32BufferAttribute, Group,
    Line, LineBasicMaterial, Matrix4, Mesh, MeshBasicMaterial, PerspectiveCamera,
    CanvasTexture, DoubleSide, PlaneGeometry, Points, PointsMaterial, Quaternion,
    RingGeometry, Scene,
    ShaderMaterial,
    SphereGeometry, SRGBColorSpace, Vector2,
    TextureLoader, Vector3, WebGLRenderer,
  } from 'three';
  import {
    Body, Ecliptic, Equator, HelioVector, MakeTime, Observer, SiderealTime,
  } from 'astronomy-engine';

  // The #include lines pull in three's logarithmic depth support. Built-in
  // materials get it injected automatically; a custom ShaderMaterial does not,
  // and without it this mesh writes depth on a different scale from everything
  // else — which is why Saturn, nine AU away, drew on top of Earth.
  const SURFACE_VERT = `
    #include <common>
    #include <logdepthbuf_pars_vertex>
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vView;
    void main() {
      vUv = uv;
      vNormal = normalize(mat3(modelMatrix) * normal);
      vec4 world = modelMatrix * vec4(position, 1.0);
      vView = normalize(cameraPosition - world.xyz);
      gl_Position = projectionMatrix * viewMatrix * world;
      #include <logdepthbuf_vertex>
    }
  `;

  const SURFACE_FRAG = `
    #include <common>
    #include <logdepthbuf_pars_fragment>
    uniform sampler2D dayMap;
    uniform sampler2D nightMap;
    uniform sampler2D cloudMap;
    uniform sampler2D waterMap;
    uniform vec3 sunDir;
    uniform float cloudShift;
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vView;

    void main() {
      #include <logdepthbuf_fragment>
      vec3 n = normalize(vNormal);
      vec3 s = normalize(sunDir);

      // Soft terminator. A hard step reads as a paper cut-out.
      float lit = smoothstep(-0.14, 0.26, dot(n, s));

      vec3 day = texture2D(dayMap, vUv).rgb;
      vec3 night = texture2D(nightMap, vUv).rgb;
      // Offset from the surface UV so the deck drifts over the ground
      // rather than being painted onto it.
      float cloud = texture2D(cloudMap, vec2(fract(vUv.x + cloudShift), vUv.y)).r;
      float water = texture2D(waterMap, vUv).r;

      vec3 halfway = normalize(s + vView);
      float glint = pow(max(dot(n, halfway), 0.0), 48.0) * water * lit;

      vec3 colour = mix(day * 0.045, day, lit);
      colour += night * (1.0 - lit) * 1.5;
      colour += vec3(1.0, 0.94, 0.82) * glint * 0.55;

      vec3 cloudColour = mix(vec3(0.015, 0.02, 0.03), vec3(1.0), lit);
      colour = mix(colour, cloudColour, clamp(cloud * 1.15, 0.0, 0.92));

      float rim = pow(1.0 - max(dot(n, vView), 0.0), 3.2);
      colour += vec3(0.28, 0.52, 1.0) * rim * lit * 0.55;

      gl_FragColor = vec4(colour, 1.0);
    }
  `;

  const AIR_FRAG = `
    #include <common>
    #include <logdepthbuf_pars_fragment>
    uniform vec3 sunDir;
    varying vec3 vNormal;
    varying vec3 vView;
    void main() {
      #include <logdepthbuf_fragment>
      vec3 n = normalize(vNormal);
      float rim = pow(1.0 - abs(dot(n, vView)), 3.4);
      float lit = smoothstep(-0.45, 0.55, dot(n, normalize(sunDir)));
      gl_FragColor = vec4(vec3(0.33, 0.6, 1.0), rim * lit * 0.95);
    }
  `;

  /** How close the pointer must come to a planet, in px. */
  const HIT_PX = 26;
  /** Meteors on screen at once, and the gap between them in seconds. */
  const METEORS = 3;
  const METEOR_GAP: [number, number] = [11, 34];
  const METEOR_LIFE = 2.4;

  /** Roll of the ecliptic across the frame, radians. */
  const ECLIPTIC_ROLL = 0.42;
  /** Camera drift, as a fraction of the offset from Earth. Scene units are
   *  AU now, so an absolute figure here would fling the camera at the Sun. */
  const SHAKE = 0.06;
  /** Drift of the cloud deck, in texture widths per second. */
  const CLOUD_DRIFT = 0.0022;

  // Scene units are astronomical units. Distances are the real ones, so the
  // camera sitting at Earth genuinely cannot see an outer planet except when
  // it is near conjunction — behind the Sun.
  //
  // Sizes cannot be real as well. From here the Sun is 954 arcsec across and
  // Jupiter is 16: one exaggeration factor for both puts the Sun at 90px and
  // Jupiter at 1.5. So apparent size is made to fall off with the square root
  // of distance rather than linearly — far things still read as far, without
  // vanishing.
  const SIZE_AT_5AU: Partial<Record<Body, number>> = {
    [Body.Mercury]: 0.045,
    [Body.Venus]: 0.070,
    [Body.Mars]: 0.055,
    [Body.Jupiter]: 0.160,
    [Body.Saturn]: 0.140,
    [Body.Uranus]: 0.090,
    [Body.Neptune]: 0.085,
  };
  const SUN_RADIUS = 0.15;

  /** Sidereal orbital periods, days. */
  const PERIOD: Partial<Record<Body, number>> = {
    [Body.Mercury]: 87.969,
    [Body.Venus]: 224.701,
    [Body.Earth]: 365.256,
    [Body.Mars]: 686.980,
    [Body.Jupiter]: 4332.589,
    [Body.Saturn]: 10759.22,
    [Body.Uranus]: 30685.4,
    [Body.Neptune]: 60189.0,
  };
  /** Earth's drawn size, on the same footing as the other planets. */
  const EARTH_SIZE_AT_5AU = 0.075;

  /** How far off Earth the camera floats, in AU. Earth's radius is 4.26e-5. */
  /**
   * How far the camera rises out of the ecliptic, in AU.
   *
   * Strictly, a camera at Earth is *in* the plane and every orbit collapses to
   * a line — which is exactly why the zodiac is a band. Lifting clear of it is
   * the one deliberate departure from the real vantage, and it is what turns
   * the orbits into open ellipses.
   */
  const CAMERA_LIFT = 0.42;
  /**
   * Pull back along the Sun line, and step sideways off it, both in AU.
   *
   * Sitting directly behind Earth puts it 37 degrees off the Sun — outside the
   * frame, and on the Sun line anyway, so it would eclipse it. Backing off and
   * stepping aside closes that to 18 degrees and separates the two, at the
   * cost of a smaller Sun.
   */
  const CAMERA_BACK = 0.80;
  const CAMERA_SIDE = 0.40;

  /**
   * Earth is drawn as a foreground body a fixed distance from the camera
   * rather than at its true size and place. At this lift it would otherwise be
   * a tenth of a pixel. Distances and positions of everything else stay real.
   */
  const EARTH_AT = 0.02;
  const EARTH_RADIUS = EARTH_AT * 0.33;
  const EARTH_SIDE = 0.50;
  const EARTH_RISE = 0.08;

  /** The main belt really does sit between roughly 2.1 and 3.4 AU. */
  const BELT_INNER = 2.1;
  const BELT_OUTER = 3.4;
  const BELT_COUNT = 2200;
  const BELT_THICKNESS = 0.14;

  /** Sky radius. Everything distant lives just inside it. */
  const SKY = 90;
  const PLANET_SHELL = 70;

  /**
   * Artistic speed-up for the idle spin: one real second is this many minutes
   * of Earth rotation. Purely a looks decision — the date still sets where the
   * rotation starts from.
   */
  const SPIN_MINUTES_PER_SECOND = 7;

  type Look = 'cratered' | 'swirled' | 'rusty' | 'banded' | 'pale' | 'deep';

  interface PlanetDef {
    body: Body;
    /** Drawn radius. Real ratios span 1:28 and are unusable; order is kept. */
    size: number;
    look: Look;
    base: string;
    mark: string;
    ring?: boolean;
  }

  const PLANETS: PlanetDef[] = [
    { body: Body.Mercury, size: 0.17, look: 'cratered', base: '#9a948c', mark: '#6b665f' },
    { body: Body.Venus, size: 0.24, look: 'swirled', base: '#d9bd85', mark: '#f2e3bb' },
    { body: Body.Mars, size: 0.20, look: 'rusty', base: '#b5563a', mark: '#7d3524' },
    { body: Body.Jupiter, size: 0.46, look: 'banded', base: '#cbae86', mark: '#8d6f4e' },
    { body: Body.Saturn, size: 0.40, look: 'banded', base: '#d8c193', mark: '#a08a62', ring: true },
    { body: Body.Uranus, size: 0.29, look: 'pale', base: '#9fd3da', mark: '#7fb9c4' },
    { body: Body.Neptune, size: 0.28, look: 'deep', base: '#5a7fd4', mark: '#31509b' },
  ];

  /** Geocentric, for RA/Dec that matches the star map's frame. */
  const GEO = new Observer(0, 0, 0);

  let renderer: WebGLRenderer | null = null;
  let scene: Scene | null = null;
  let camera: PerspectiveCamera | null = null;
  let globe: Mesh | null = null;
  /** Everything fixed to the celestial sphere: stars, Sun, planets. */
  let sky: Group | null = null;
  /** Carries the same rotation, so Earth’s axis stays on the celestial pole. */
  let earthPivot: Group | null = null;
  let sunDir: Vector3 | null = null;
  let sunMesh: Mesh | null = null;
  let surfaceMat: ShaderMaterial | null = null;
  /** The Sun and its planets, held flat and tilted in front of the camera. */
  let system: Group | null = null;
  /** Spun so Earth’s side of the orbit always faces the viewer. */
  let systemSpin: Group | null = null;
  let belt: Points | null = null;
  let sunGlow: Mesh | null = null;
  /** Where the camera sits before drift is added. */
  const cameraBase = new Vector3();
  let label: HTMLElement | null = null;
  const pointer = new Vector2(-9999, -9999);
  const projected = new Vector3();

  interface Meteor { line: Line; from: Vector3; to: Vector3; at: number; next: number }
  const meteors: Meteor[] = [];
  const planetMeshes = new Map<Body, Mesh>();

  let day = 1;
  let exact = 1;
  let frame = 0;
  let baseSpin = 0;
  let startedAt = 0;
  let wired = false;

  /** Fractional day of year to a real instant, time-of-day included. */
  function dateOfDay(d: number): Date {
    const year = new Date().getUTCFullYear();
    return new Date(Date.UTC(year, 0, 1) + (d - 1) * 86_400_000);
  }

  /**
   * RA (hours) and Dec (degrees) to a direction, matching how SphereGeometry
   * lays out its UVs — so the star map, the planets and the Sun all share one
   * frame and line up with each other.
   */
  function direction(ra: number, dec: number): Vector3 {
    const phi = (ra / 24) * Math.PI * 2;
    const theta = ((90 - dec) * Math.PI) / 180;
    return new Vector3(
      -Math.cos(phi) * Math.sin(theta),
      Math.cos(theta),
      Math.sin(phi) * Math.sin(theta),
    );
  }

  function equatorOf(body: Body, when: Date): { ra: number; dec: number } {
    const eq = Equator(body, MakeTime(when), GEO, false, true);
    return { ra: eq.ra, dec: eq.dec };
  }

/**
   * Fixes the viewing angle on the ecliptic — the band every planet travels
   * along. It does not follow anything, so planets drift in and out of frame
   * on their own as the date moves, which is the point.
   */
  function aim(): void {
    if (!sky) return;

    const target = direction(0, 0); // vernal equinox

    // Up is the ecliptic pole, rolled a little so the plane crosses the
    // frame diagonally rather than sitting flat across it.
    const up = direction(18, 66.56).applyAxisAngle(target, ECLIPTIC_ROLL);

    const basis = new Matrix4().lookAt(new Vector3(), target, up);
    sky.quaternion.copy(new Quaternion().setFromRotationMatrix(basis).invert());
  }

  /** Sun direction, planet positions and the rotation the date starts from. */
  function orient(when: Date): void {
    if (!sunDir || !globe) return;
    aim();

    // Taking the Sun's real declination is what puts the seasons in: it swings
    // +/-23.4 degrees across the year on its own. Tilting the globe instead
    // would have thrown it out of line with the celestial pole.
    // sunDir is set in placeEarth, from where the globe actually ends up.

    // Everything is placed at its true heliocentric position, in AU, with the
    // Sun at the origin. The camera floats just off Earth and looks sunward,
    // so what falls inside the field of view is decided by real geometry
    // rather than by arranging things to be seen.
    const home = helioOf3(Body.Earth, when);

    if (camera) {
      // Offset sideways from Earth so the globe sits in frame rather than
      // filling it, then point the camera at the Sun.
      const outward = home.clone().normalize();
      const side = new Vector3().crossVectors(outward, new Vector3(0, 1, 0)).normalize();
      cameraBase.copy(home)
        .addScaledVector(outward, CAMERA_BACK)
        .addScaledVector(side, CAMERA_SIDE)
        .add(new Vector3(0, CAMERA_LIFT, 0));
      camera.position.copy(cameraBase);
      camera.lookAt(0, 0, 0);
      placeEarth(when);
      // Billboard the corona: the camera walks right round the Sun over a
      // year, so a fixed orientation shows the plane edge-on half the time.
      sunGlow?.lookAt(camera.position);
      if (sky) sky.position.copy(camera.position);
    }

    for (const planet of PLANETS) {
      const mesh = planetMeshes.get(planet.body);
      if (!mesh) continue;
      const at = helioOf3(planet.body, when);
      mesh.position.copy(at);

      // Apparent size falls off with the square root of distance, so Neptune
      // at 29 AU is still a visible speck rather than a tenth of a pixel.
      const dist = camera ? at.distanceTo(camera.position) : 1;
      const base = SIZE_AT_5AU[planet.body] ?? 0.08;
      const radius = base * Math.sqrt(Math.max(dist, 0.05) / 5);
      mesh.scale.setScalar(radius / planet.size);
      mesh.rotation.y += 0.004;
    }

    baseSpin = (SiderealTime(MakeTime(when)) / 24) * Math.PI * 2;
  }

  /**
   * A planet's apparent track across the sky over the whole year, sampled from
   * its real geocentric position. Not a tidy ellipse — seen from a moving
   * Earth these curl back on themselves at opposition, which is retrograde
   * motion and is exactly what should be there.
   */
  function pathOf(body: Body, colour: number): Line {
    const year = new Date().getUTCFullYear();
    const total = Math.round((Date.UTC(year + 1, 0, 1) - Date.UTC(year, 0, 1)) / 86_400_000);
    const points: number[] = [];
    for (let d = 1; d <= total; d += 3) {
      const eq = equatorOf(body, dateOfDay(d));
      const v = direction(eq.ra, eq.dec).multiplyScalar(PLANET_SHELL * 0.995);
      points.push(v.x, v.y, v.z);
    }
    const geometry = new BufferGeometry();
    geometry.setAttribute('position', new Float32BufferAttribute(points, 3));
    return new Line(geometry, new LineBasicMaterial({
      color: colour,
      transparent: true,
      opacity: 0.18,
      depthWrite: false,
    }));
  }


  /**
   * Procedural surface for each planet, drawn to a canvas and wrapped as an
   * equirectangular map. No texture downloads: a few hundred bytes of code
   * instead of a few hundred kilobytes of imagery, and enough of a design that
   * each body is recognisable at this size.
   */
  function surfaceOf(def: PlanetDef): CanvasTexture {
    const w = 256;
    const h = 128;
    const c = document.createElement('canvas');
    c.width = w;
    c.height = h;
    const g = c.getContext('2d')!;

    g.fillStyle = def.base;
    g.fillRect(0, 0, w, h);

    // Deterministic, so a planet looks the same on every visit.
    let seed = def.size * 9973;
    const rnd = (): number => {
      seed = (seed * 16807) % 2147483647;
      return seed / 2147483647;
    };

    if (def.look === 'banded' || def.look === 'pale' || def.look === 'deep') {
      const bands = def.look === 'banded' ? 14 : 7;
      for (let i = 0; i < bands; i++) {
        const y = (i / bands) * h;
        const tall = (h / bands) * (0.45 + rnd() * 0.75);
        g.globalAlpha = def.look === 'banded' ? 0.30 + rnd() * 0.35 : 0.12 + rnd() * 0.16;
        g.fillStyle = i % 2 ? def.mark : def.base;
        g.fillRect(0, y, w, tall);
      }
      g.globalAlpha = 1;

      if (def.look === 'banded' && def.body === Body.Jupiter) {
        // The Great Red Spot.
        g.fillStyle = '#a8543c';
        g.beginPath();
        g.ellipse(w * 0.62, h * 0.63, w * 0.075, h * 0.055, 0, 0, Math.PI * 2);
        g.fill();
      }
      if (def.look === 'deep') {
        g.fillStyle = '#20356e';
        g.beginPath();
        g.ellipse(w * 0.4, h * 0.45, w * 0.07, h * 0.05, 0, 0, Math.PI * 2);
        g.fill();
      }
    }

    if (def.look === 'cratered') {
      for (let i = 0; i < 90; i++) {
        const r = 1.5 + rnd() * 6;
        g.globalAlpha = 0.18 + rnd() * 0.3;
        g.fillStyle = rnd() > 0.5 ? def.mark : '#b6b0a7';
        g.beginPath();
        g.arc(rnd() * w, rnd() * h, r, 0, Math.PI * 2);
        g.fill();
      }
      g.globalAlpha = 1;
    }

    if (def.look === 'rusty') {
      for (let i = 0; i < 40; i++) {
        g.globalAlpha = 0.16 + rnd() * 0.24;
        g.fillStyle = def.mark;
        g.beginPath();
        g.ellipse(rnd() * w, rnd() * h, 6 + rnd() * 26, 4 + rnd() * 12, rnd() * 3, 0, Math.PI * 2);
        g.fill();
      }
      g.globalAlpha = 1;
      // Polar caps.
      g.fillStyle = '#e8e2dc';
      g.fillRect(0, 0, w, 4);
      g.fillRect(0, h - 5, w, 5);
    }

    if (def.look === 'swirled') {
      for (let i = 0; i < 26; i++) {
        g.globalAlpha = 0.14 + rnd() * 0.2;
        g.strokeStyle = rnd() > 0.5 ? def.mark : '#b99b63';
        g.lineWidth = 3 + rnd() * 9;
        g.beginPath();
        const y = rnd() * h;
        g.moveTo(0, y);
        g.bezierCurveTo(w * 0.3, y + (rnd() - 0.5) * 30, w * 0.7, y + (rnd() - 0.5) * 30, w, y);
        g.stroke();
      }
      g.globalAlpha = 1;
    }

    const texture = new CanvasTexture(c);
    texture.colorSpace = SRGBColorSpace;
    return texture;
  }

  /**
   * Soft radial falloff for the corona. Nested spheres with flat opacity
   * render as hard-edged discs — a sphere has no falloff across its face, so
   * each shell reads as a solid ring rather than glow.
   */
  function glowTexture(): CanvasTexture {
    const size = 256;
    const c = document.createElement('canvas');
    c.width = size;
    c.height = size;
    const g = c.getContext('2d')!;
    const grad = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
    grad.addColorStop(0, 'rgba(255,248,224,1)');
    grad.addColorStop(0.09, 'rgba(255,226,150,0.85)');
    grad.addColorStop(0.22, 'rgba(255,183,88,0.34)');
    grad.addColorStop(0.48, 'rgba(255,146,52,0.10)');
    grad.addColorStop(1, 'rgba(255,130,40,0)');
    g.fillStyle = grad;
    g.fillRect(0, 0, size, size);
    return new CanvasTexture(c);
  }

  /** Heliocentric ecliptic position, in AU, all three axes. */
  function helioOf3(body: Body, when: Date): Vector3 {
    const e = Ecliptic(HelioVector(body, MakeTime(when)));
    // Ecliptic z becomes scene y, so the orbital plane lies flat.
    return new Vector3(e.vec.x, e.vec.z, e.vec.y);
  }

  /** Compressed radius for an orbit, in scene units. */
  function orbitRadius(au: number): number {
    return (SYSTEM_REACH / Math.pow(30, FALLOFF)) * Math.pow(au, FALLOFF);
  }

  /**
   * One full revolution of a body, sampled from the ephemeris.
   *
   * A flat circle at the body's current distance cannot touch it: every orbit
   * is inclined to the ecliptic and none is a perfect circle, so the ring
   * passed above or below the planet it was supposed to belong to. Walking the
   * real orbit puts the line through the body by construction.
   */
  function orbitLine(body: Body, colour: number, opacity: number): Line {
    const period = PERIOD[body] ?? 365;
    const from = dateOfDay(exact).getTime();
    const points: number[] = [];
    for (let i = 0; i <= 192; i++) {
      const at = new Date(from + (i / 192) * period * 86_400_000);
      const v = helioOf3(body, at);
      points.push(v.x, v.y, v.z);
    }
    const geometry = new BufferGeometry();
    geometry.setAttribute('position', new Float32BufferAttribute(points, 3));
    return new Line(geometry, new LineBasicMaterial({
      color: colour,
      transparent: true,
      opacity,
      depthWrite: false,
    }));
  }

  /** Screen-space pick. Cheaper and far more forgiving than raycasting a
   *  sphere a handful of pixels wide. */
  function hover(): void {
    if (!camera || !label || !scene) return;
    if (pointer.x < 0) { label.hidden = true; return; }

    scene.updateMatrixWorld();
    const w = window.innerWidth;
    const h = window.innerHeight;

    let bestName = '';
    let bestX = 0;
    let bestY = 0;
    let bestDist = HIT_PX;

    for (const [body, mesh] of planetMeshes) {
      projected.setFromMatrixPosition(mesh.matrixWorld).project(camera);
      if (projected.z > 1) continue; // behind the camera
      const sx = (projected.x * 0.5 + 0.5) * w;
      const sy = (-projected.y * 0.5 + 0.5) * h;
      const dist = Math.hypot(sx - pointer.x, sy - pointer.y);
      if (dist < bestDist) {
        bestDist = dist;
        bestName = String(body).toLowerCase();
        bestX = sx;
        bestY = sy;
      }
    }

    if (!bestName) { label.hidden = true; return; }
    label.textContent = bestName;
    label.style.left = bestX + 'px';
    label.style.top = bestY + 'px';
    label.hidden = false;
  }

  /** Re-arms a meteor somewhere in frame, heading in a random direction. */
  function armMeteor(m: Meteor): void {
    if (!camera) return;
    const nx = Math.random() * 1.7 - 0.85;
    const ny = Math.random() * 1.2 - 0.3;
    const angle = Math.random() * Math.PI * 2;
    const reach = 0.35 + Math.random() * 0.5;

    m.from.set(nx, ny, 0.5).unproject(camera);
    m.to.set(nx + Math.cos(angle) * reach, ny + Math.sin(angle) * reach * 0.6, 0.5)
      .unproject(camera);
    m.at = 0;
    m.next = METEOR_GAP[0] + Math.random() * (METEOR_GAP[1] - METEOR_GAP[0]);
  }

  function stepMeteors(delta: number): void {
    for (const m of meteors) {
      if (m.at < 0) {
        m.next -= delta;
        if (m.next > 0) continue;
        armMeteor(m);
      }

      m.at += delta / METEOR_LIFE;
      if (m.at >= 1) {
        m.at = -1;
        (m.line.material as LineBasicMaterial).opacity = 0;
        continue;
      }

      const head = m.at;
      const tail = Math.max(0, m.at - 0.22);
      const pos = m.line.geometry.getAttribute('position');
      const a = m.from.clone().lerp(m.to, tail);
      const b = m.from.clone().lerp(m.to, head);
      pos.setXYZ(0, a.x, a.y, a.z);
      pos.setXYZ(1, b.x, b.y, b.z);
      pos.needsUpdate = true;

      // Bright as it enters, gone by the end of the streak.
      // Rises quickly, falls away slowly, rather than a symmetric blink.
      const fade = m.at < 0.18 ? m.at / 0.18 : Math.pow(1 - (m.at - 0.18) / 0.82, 1.7);
      (m.line.material as LineBasicMaterial).opacity = fade * 0.9;
    }
  }

  /**
   * Earth sits on its own orbit like every other body, at its true position.
   * Only its drawn size is exaggerated, by the same square-root rule the
   * planets use — at half an AU the real thing is six hundredths of a pixel.
   */
  function placeEarth(when: Date): void {
    if (!camera || !earthPivot || !sunDir) return;

    const home = helioOf3(Body.Earth, when);
    earthPivot.position.copy(home);

    const dist = home.distanceTo(camera.position);
    const radius = EARTH_SIZE_AT_5AU * Math.sqrt(Math.max(dist, 0.05) / 5);
    earthPivot.scale.setScalar(radius / EARTH_RADIUS);

    // Lit from the Sun, which is at the origin.
    sunDir.copy(home).negate().normalize();
  }

  function size(): void {
    if (!renderer || !camera) return;
    const w = window.innerWidth;
    const h = window.innerHeight;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }

  function render(): void {
    if (renderer && scene && camera) renderer.render(scene, camera);
  }

  function tick(): void {
    frame = requestAnimationFrame(tick);
    if (!globe) return;
    const elapsed = (performance.now() - startedAt) / 1000;
    const turns = (elapsed * SPIN_MINUTES_PER_SECOND) / (24 * 60);
    globe.rotation.y = baseSpin + turns * Math.PI * 2;
    // Clouds run slightly ahead of the ground beneath them.
    if (surfaceMat) surfaceMat.uniforms.cloudShift.value = elapsed * CLOUD_DRIFT;
    stepMeteors(1 / 60);

    // A slow wander on two incommensurate frequencies, so it never settles
    // into an obvious loop.
    if (camera) {
      const wander = CAMERA_LIFT * SHAKE * 0.02;
      camera.position.copy(cameraBase);
      camera.position.x += Math.sin(elapsed * 0.19) * wander + Math.sin(elapsed * 0.11) * wander * 0.6;
      camera.position.y += Math.cos(elapsed * 0.13) * wander * 0.7;
      camera.lookAt(0, 0, 0);
      camera.rotateZ(Math.sin(elapsed * 0.07) * 0.004);
      placeEarth(dateOfDay(exact));
      sunGlow?.lookAt(camera.position);
      if (sky) sky.position.copy(camera.position);
    }

    hover();
    render();
  }

  function setup(): void {
    const host = document.querySelector<HTMLElement>('[data-globe]');
    if (!host || host.dataset.wired === 'yes') return;

    let gl: WebGLRenderer;
    try {
      gl = new WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: 'low-power',
        // Earth's radius is 4.3e-5 AU and Neptune is 30 AU out: a seven-order
        // depth range that a normal buffer cannot resolve.
        logarithmicDepthBuffer: true,
      });
    } catch {
      return; // No WebGL: leave the page as it is.
    }
    host.dataset.wired = 'yes';

    renderer = gl;
    renderer.setClearAlpha(0);
    host.appendChild(renderer.domElement);

    scene = new Scene();
    camera = new PerspectiveCamera(46, 1, 0.000004, 400);

    sunDir = new Vector3(1, 0, 0);

    const loader = new TextureLoader();
    const load = (file: string, srgb: boolean) => {
      const t = loader.load(`/earth/${file}`, render);
      if (srgb) t.colorSpace = SRGBColorSpace;
      return t;
    };

    // --- sky -------------------------------------------------------------
    sky = new Group();
    scene.add(sky);

    const stars = new Mesh(
      new SphereGeometry(140, 64, 32),
      // Knocked well back: at full strength the map's diffuse galactic light
      // greys the whole frame and the globe stops being the subject.
      new MeshBasicMaterial({
        map: load('starmap.webp', true),
        color: 0x5a6270,
        side: BackSide,
        depthWrite: false,
      }),
    );
    sky.add(stars);

    // --- the globe ---------------------------------------------------------
    surfaceMat = new ShaderMaterial({
      uniforms: {
        dayMap: { value: load('day.webp', true) },
        nightMap: { value: load('night.webp', true) },
        cloudMap: { value: load('clouds.webp', false) },
        waterMap: { value: load('water.webp', false) },
        sunDir: { value: sunDir },
        cloudShift: { value: 0 },
      },
      vertexShader: SURFACE_VERT,
      fragmentShader: SURFACE_FRAG,
    });
    const surface = surfaceMat;

    earthPivot = new Group();
    scene.add(earthPivot);

    globe = new Mesh(new SphereGeometry(EARTH_RADIUS, 96, 96), surface);
    // No axial tilt here: the spin axis IS the celestial pole. The pivot
    // carries the sky's rotation so the two stay aligned.
    earthPivot.add(globe);

    const air = new Mesh(
      new SphereGeometry(EARTH_RADIUS * 1.035, 64, 64),
      new ShaderMaterial({
        uniforms: { sunDir: { value: sunDir } },
        vertexShader: SURFACE_VERT,
        fragmentShader: AIR_FRAG,
        blending: AdditiveBlending,
        side: BackSide,
        transparent: true,
        depthWrite: false,
      }),
    );
    earthPivot.add(air);

    // --- sun and planets ---------------------------------------------------
    // A flat disc laid out in front of the camera and tilted, rather than
    // anything on the celestial sphere. The Sun is the fixed centre of it.
    // No tilt and no spin any more: the Sun is simply at the origin and
    // everything sits where it really is, in AU.
    system = new Group();
    scene.add(system);
    systemSpin = system;

    sunMesh = new Mesh(
      new SphereGeometry(SUN_RADIUS, 48, 48),
      new MeshBasicMaterial({ color: 0xfff3d2 }),
    );
    systemSpin.add(sunMesh);

    const glow = new Mesh(
      new PlaneGeometry(SUN_RADIUS * 13, SUN_RADIUS * 13),
      new MeshBasicMaterial({
        map: glowTexture(),
        transparent: true,
        blending: AdditiveBlending,
        depthWrite: false,
        // Depth testing must stay on. Transparent objects are drawn after all
        // opaque ones, so with it off the corona painted straight over Earth
        // even though Earth is a hundredth of an AU away and the Sun is one.
        depthTest: true,
      }),
    );
    // Billboarded toward the camera rather than lying flat in the plane.
    sunGlow = glow;

    sunMesh.add(glow);

    for (const planet of PLANETS) {
      const mesh = new Mesh(
        new SphereGeometry(planet.size, 32, 24),
        new MeshBasicMaterial({ map: surfaceOf(planet) }),
      );
      planetMeshes.set(planet.body, mesh);
      systemSpin.add(mesh);

      if (planet.ring) {
        const ring = new Mesh(
          new RingGeometry(planet.size * 1.45, planet.size * 2.25, 48),
          new MeshBasicMaterial({
            color: 0xe0cba0,
            side: DoubleSide,
            transparent: true,
            opacity: 0.55,
            depthWrite: false,
          }),
        );
        // Flat in the orbital plane, so it reads as a ring rather than a disc
        // seen face-on.
        ring.rotation.x = Math.PI / 2;
        mesh.add(ring);
      }

      systemSpin.add(orbitLine(planet.body, 0x8fa4c4, 0.20));
    }

    // Earth's own orbit, drawn brighter: it is the line everything else is
    // outside of, and the reason the outer planets sit where they do.
    systemSpin.add(orbitLine(Body.Earth, 0x9ec4ff, 0.40));

    // --- the main belt -----------------------------------------------------
    // Between Mars and Jupiter, where it actually is. Scattered rather than a
    // clean annulus: the real belt is neither uniform nor flat.
    {
      const coords: number[] = [];
      let seed = 4919;
      const rnd = (): number => {
        seed = (seed * 16807) % 2147483647;
        return seed / 2147483647;
      };
      for (let i = 0; i < BELT_COUNT; i++) {
        // Biased toward the middle of the belt.
        const t = (rnd() + rnd()) / 2;
        const radius = BELT_INNER + t * (BELT_OUTER - BELT_INNER);
        const angle = rnd() * Math.PI * 2;
        const lift = (rnd() - 0.5) * BELT_THICKNESS;
        coords.push(Math.cos(angle) * radius, lift, Math.sin(angle) * radius);
      }
      const geometry = new BufferGeometry();
      geometry.setAttribute('position', new Float32BufferAttribute(coords, 3));
      belt = new Points(geometry, new PointsMaterial({
        color: 0xbdb3a4,
        size: 0.012,
        sizeAttenuation: true,
        transparent: true,
        opacity: 0.75,
        depthWrite: false,
      }));
      systemSpin.add(belt);
    }

    // --- meteors -----------------------------------------------------------
    for (let i = 0; i < METEORS; i++) {
      const geometry = new BufferGeometry();
      geometry.setAttribute('position', new Float32BufferAttribute([0, 0, 0, 0, 0, 0], 3));
      const line = new Line(geometry, new LineBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0,
        depthWrite: false,
      }));
      // Never culled: the endpoints move every frame and the bounding sphere
      // computed at construction would be wrong immediately.
      line.frustumCulled = false;
      scene.add(line);
      meteors.push({
        line,
        from: new Vector3(),
        to: new Vector3(),
        at: -1,
        next: Math.random() * METEOR_GAP[1],
      });
    }

    label = document.querySelector<HTMLElement>('[data-body-name]');

    size();
    orient(dateOfDay(exact));
    globe.rotation.y = baseSpin;
    render();

    if (wired) return;
    wired = true;

    window.addEventListener('resize', () => { size(); render(); });

    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      pointer.set(event.clientX, event.clientY);
      // Under reduced motion there is no loop to pick this up, so do it here.
      if (!frame) { hover(); render(); }
    }, { passive: true });

    window.addEventListener('pointerleave', () => {
      pointer.set(-9999, -9999);
      if (!frame) { hover(); render(); }
    });
    document.addEventListener('timeline:day', (event) => {
      const detail = (event as CustomEvent<{ day: number; exact: number }>).detail;
      if (!detail) return;
      day = detail.day;
      // One day of scrub is one whole rotation, so this has to follow the
      // fraction rather than the rounded day.
      exact = detail.exact ?? detail.day;
      orient(dateOfDay(exact));
      startedAt = performance.now();
      if (!frame) render();
    });

    // Idle spin, unless the visitor asked for less movement.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    startedAt = performance.now();
    frame = requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', setup);
</script>
