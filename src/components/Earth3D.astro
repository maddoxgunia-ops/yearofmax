---
// WebGL globe. Everything renders on the client: the sun angle and the
// rotation both depend on the date the timeline is parked on.
---

<div class="globe" data-globe aria-hidden="true"></div>

<style>
  .globe {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .globe canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import {
    Mesh, PerspectiveCamera, Scene, ShaderMaterial, SphereGeometry,
    SRGBColorSpace, TextureLoader, Vector3, WebGLRenderer, AdditiveBlending,
    BackSide, RepeatWrapping,
  } from 'three';
  import { Body, HelioVector, Ecliptic, MakeTime, SiderealTime } from 'astronomy-engine';

  const SURFACE_VERT = `
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vView;
    void main() {
      vUv = uv;
      vNormal = normalize(normalMatrix * normal);
      vec4 mv = modelViewMatrix * vec4(position, 1.0);
      vView = normalize(-mv.xyz);
      gl_Position = projectionMatrix * mv;
    }
  `;

  const SURFACE_FRAG = `
    uniform sampler2D dayMap;
    uniform sampler2D nightMap;
    uniform sampler2D cloudMap;
    uniform sampler2D waterMap;
    uniform vec3 sunDir;
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vView;

    void main() {
      vec3 n = normalize(vNormal);
      vec3 s = normalize(sunDir);

      // Soft terminator. A hard step reads as a paper cut-out.
      float lambert = dot(n, s);
      float lit = smoothstep(-0.14, 0.26, lambert);

      vec3 day = texture2D(dayMap, vUv).rgb;
      vec3 night = texture2D(nightMap, vUv).rgb;
      float cloud = texture2D(cloudMap, vUv).r;
      float water = texture2D(waterMap, vUv).r;

      // Sun glinting off oceans only.
      vec3 halfway = normalize(s + vView);
      float glint = pow(max(dot(n, halfway), 0.0), 48.0) * water * lit;

      // A little ambient so the night side is not pure black.
      vec3 colour = mix(day * 0.045, day, lit);
      colour += night * (1.0 - lit) * 1.5;
      colour += vec3(1.0, 0.94, 0.82) * glint * 0.55;

      // Cloud deck: white in daylight, barely there at night.
      vec3 cloudColour = mix(vec3(0.015, 0.02, 0.03), vec3(1.0), lit);
      colour = mix(colour, cloudColour, clamp(cloud * 1.15, 0.0, 0.92));

      // Forward-scattered light hugging the lit limb.
      float rim = pow(1.0 - max(dot(n, vView), 0.0), 3.2);
      colour += vec3(0.28, 0.52, 1.0) * rim * lit * 0.55;

      gl_FragColor = vec4(colour, 1.0);
    }
  `;

  const AIR_VERT = SURFACE_VERT;

  const AIR_FRAG = `
    uniform vec3 sunDir;
    varying vec3 vNormal;
    varying vec3 vView;
    void main() {
      vec3 n = normalize(vNormal);
      // Backside shell, so the fresnel is strongest where we graze the limb.
      float rim = pow(1.0 - abs(dot(n, vView)), 3.4);
      float lit = smoothstep(-0.45, 0.55, dot(n, normalize(sunDir)));
      gl_FragColor = vec4(vec3(0.33, 0.6, 1.0), rim * lit * 0.95);
    }
  `;

  let renderer: WebGLRenderer | null = null;
  let scene: Scene | null = null;
  let camera: PerspectiveCamera | null = null;
  let globe: Mesh | null = null;
  let sunDir: Vector3 | null = null;
  let day = 1;
  let wired = false;

  function dateOfDay(d: number): Date {
    const year = new Date().getUTCFullYear();
    return new Date(Date.UTC(year, 0, 1) + (d - 1) * 86_400_000 + 86_400_000 / 2);
  }

  /** Real sun direction and rotation for a date. */
  function orient(when: Date): void {
    if (!sunDir || !globe) return;

    // Earth's heliocentric longitude points away from the Sun.
    const e = Ecliptic(HelioVector(Body.Earth, MakeTime(when)));
    const lon = Math.atan2(e.vec.y, e.vec.x) + Math.PI;
    // Tilted slightly so the terminator is never a dead-vertical line.
    sunDir.set(Math.cos(lon), 0.28, Math.sin(lon)).normalize();

    // Greenwich sidereal time sets which meridian faces us.
    const gst = SiderealTime(MakeTime(when));
    globe.rotation.y = (gst / 24) * Math.PI * 2;
  }

  function size(): void {
    if (!renderer || !camera) return;
    const w = window.innerWidth;
    const h = window.innerHeight;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }

  function render(): void {
    if (renderer && scene && camera) renderer.render(scene, camera);
  }

  function setup(): void {
    const host = document.querySelector<HTMLElement>('[data-globe]');
    if (!host || host.dataset.wired === 'yes') return;

    // WebGL can be unavailable or blocked; leave the page alone if so.
    let gl: WebGLRenderer;
    try {
      gl = new WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' });
    } catch {
      return;
    }
    host.dataset.wired = 'yes';

    renderer = gl;
    renderer.setClearAlpha(0);
    host.appendChild(renderer.domElement);

    scene = new Scene();
    camera = new PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(0, 0, 2.5);

    sunDir = new Vector3(1, 0.28, 0.4).normalize();

    const loader = new TextureLoader();
    const load = (file: string, srgb: boolean) => {
      const t = loader.load(`/earth/${file}`, render);
      if (srgb) t.colorSpace = SRGBColorSpace;
      t.wrapS = RepeatWrapping;
      return t;
    };

    const surface = new ShaderMaterial({
      uniforms: {
        dayMap: { value: load('day.webp', true) },
        nightMap: { value: load('night.webp', true) },
        cloudMap: { value: load('clouds.webp', false) },
        waterMap: { value: load('water.webp', false) },
        sunDir: { value: sunDir },
      },
      vertexShader: SURFACE_VERT,
      fragmentShader: SURFACE_FRAG,
    });

    globe = new Mesh(new SphereGeometry(1, 96, 96), surface);
    // Axial tilt, and pushed down so the limb crosses the upper third.
    globe.rotation.z = (-23.44 * Math.PI) / 180;
    globe.position.y = -1.15;
    scene.add(globe);

    const air = new Mesh(
      new SphereGeometry(1.035, 64, 64),
      new ShaderMaterial({
        uniforms: { sunDir: { value: sunDir } },
        vertexShader: AIR_VERT,
        fragmentShader: AIR_FRAG,
        blending: AdditiveBlending,
        side: BackSide,
        transparent: true,
        depthWrite: false,
      }),
    );
    air.position.y = globe.position.y;
    scene.add(air);

    size();
    orient(dateOfDay(day));
    render();

    if (wired) return;
    wired = true;

    window.addEventListener('resize', () => { size(); render(); });
    document.addEventListener('timeline:day', (event) => {
      const next = (event as CustomEvent<{ day: number }>).detail?.day;
      if (typeof next !== 'number' || next === day) return;
      day = next;
      orient(dateOfDay(day));
      render();
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
