---
import * as C from '../../scripts/tools/colour';

// Rendered at build time so the card is a real ramp before any script runs.
const START = C.parseHex('#D83F46') ?? { r: 216, g: 63, b: 70 };
const ramp = C.strip(START);
---

<span class="ramp" data-colour-card>
  {ramp.map((c) => (
    <span class="ramp__step" style={`background:#${C.toHex(c)}`}></span>
  ))}
</span>

<style>
  .ramp {
    display: flex;
    height: 54px;
    margin-top: 1.1rem;
    border: var(--hairline) solid var(--rule);
  }

  .ramp__step {
    flex: 1;
  }
</style>

<script>
  import { strip, toHex, rgbToHslExact, hslToRgb, parseHex } from '../../scripts/tools/colour';

  function setup(): void {
    const card = document.querySelector<HTMLElement>('[data-colour-card]');
    if (!card) return;
    if (card.dataset.wired === 'yes') return;
    card.dataset.wired = 'yes';

    const steps = Array.from(card.querySelectorAll<HTMLElement>('.ramp__step'));
    // The card sits inside the link, so the pointer target is the whole row.
    const surface = card.closest<HTMLElement>('.card') ?? card;

    // Keep whatever was rendered at build time. Randomising here would swap
    // the ramp visibly a frame after paint.
    const base = parseHex('#D83F46') ?? { r: 216, g: 63, b: 70 };

    const paint = (rgb: typeof base): void => {
      strip(rgb).forEach((c, i) => {
        const node = steps[i];
        if (node) node.style.background = '#' + toHex(c);
      });
    };

    // Hue tracks the pointer across the row. No click is involved, so the card
    // stays a plain link and nothing swallows the navigation.
    surface.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = surface.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width));
      const hsl = rgbToHslExact(base);
      paint(hslToRgb({ h: x * 360, s: hsl.s, l: hsl.l }));
    });

    surface.addEventListener('pointerleave', () => paint(base));
  }

  document.addEventListener('astro:page-load', setup);
</script>
