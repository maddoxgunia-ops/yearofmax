---
import * as U from '../../scripts/tools/units';

// A ruler. Rendered at build time as a real measurement so the card means
// something before any script runs, and with no script at all.
const TICKS = 48;
const START = 1;

const metric = U.findUnit('m')[0]!;
const imperial = U.findUnit('ft')[0]!;
---

<span class="rule" data-convert-card data-start={START}>
  <span class="rule__ticks" aria-hidden="true">
    {Array.from({ length: TICKS }, (_, i) => (
      <span class={`rule__tick${i % 6 === 0 ? ' rule__tick--major' : ''}`}></span>
    ))}
  </span>
  <span class="rule__read">
    <span class="rule__value" data-metric>{U.format(START, 4)} {metric.symbol}</span>
    <span class="rule__value" data-imperial>{U.format(START / imperial.factor, 4)} {imperial.symbol}</span>
  </span>
</span>

<style>
  .rule {
    display: block;
    margin-top: 1.1rem;
    border: var(--hairline) solid var(--rule);
    padding: 0.9rem 1rem 0.8rem;
  }

  .rule__ticks {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 28px;
  }

  .rule__tick {
    width: var(--hairline);
    height: 8px;
    background: var(--rule);
    transition: background-color 420ms ease;
  }

  .rule__tick--major {
    height: 20px;
  }

  .rule__read {
    display: flex;
    justify-content: space-between;
    margin-top: 0.7rem;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
    font-stretch: var(--wdth-narrow);
    font-size: var(--size-label);
    letter-spacing: var(--track-label);
  }

  .card:hover .rule__tick {
    background: var(--ink);
  }
</style>

<script>
  import { findUnit, format, type Unit } from '../../scripts/tools/units';

  /** Smallest unit in which the length reads as one or more. */
  function best(metres: number, ladder: Unit[]): Unit {
    for (let i = ladder.length - 1; i >= 0; i -= 1) {
      const unit = ladder[i]!;
      if (metres / unit.factor >= 1) return unit;
    }
    return ladder[0]!;
  }

  function setup(): void {
    const card = document.querySelector<HTMLElement>('[data-convert-card]');
    if (!card) return;
    if (card.dataset.wired === 'yes') return;
    card.dataset.wired = 'yes';

    const metricLadder = ['mm', 'cm', 'm', 'km'].map((s) => findUnit(s)[0]).filter(Boolean) as Unit[];
    const imperialLadder = ['in', 'ft', 'yd', 'mi'].map((s) => findUnit(s)[0]).filter(Boolean) as Unit[];
    if (!metricLadder.length || !imperialLadder.length) return;

    const metricOut = card.querySelector<HTMLElement>('[data-metric]');
    const imperialOut = card.querySelector<HTMLElement>('[data-imperial]');
    // The card sits inside the link, so the pointer target is the whole row.
    const surface = card.closest<HTMLElement>('.card') ?? card;

    const paint = (metres: number): void => {
      const m = best(metres, metricLadder);
      const i = best(metres, imperialLadder);
      if (metricOut) metricOut.textContent = `${format(metres / m.factor, 4)} ${m.symbol}`;
      if (imperialOut) imperialOut.textContent = `${format(metres / i.factor, 4)} ${i.symbol}`;
    };

    // Log scale: a millimetre at the left edge, a kilometre at the right, so
    // the whole span a person reaches for fits in one sweep.
    surface.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = surface.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width));
      paint(10 ** (-3 + x * 6));
    });

    surface.addEventListener('pointerleave', () => paint(1));
  }

  document.addEventListener('astro:page-load', setup);
</script>
