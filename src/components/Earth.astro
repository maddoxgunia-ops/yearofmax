---
// Lighting is driven by Earth's real heliocentric longitude on the scrubbed
// date, so the terminator rotates as the year advances.
---

<canvas class="earth" data-earth aria-hidden="true"></canvas>

<style>
  .earth {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import { Body, HelioVector, Ecliptic, MakeTime } from 'astronomy-engine';

  /** Where the globe sits, as fractions of the viewport. */
  const CENTRE_X = 0.5;
  const CENTRE_Y = 1.34;
  const RADIUS = 1.06;

  /** Segments used to sweep the limb, for light that falls off around it. */
  const SEGMENTS = 96;

  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let day = 1;
  let wired = false;

  function dateOfDay(d: number): Date {
    const year = new Date().getUTCFullYear();
    return new Date(Date.UTC(year, 0, 1) + (d - 1) * 86_400_000 + 86_400_000 / 2);
  }

  /**
   * Screen-space direction of the Sun. Earth's heliocentric longitude points
   * away from the Sun, so the sub-solar side is that longitude plus half a
   * turn. Scrubbing the year therefore walks the terminator around the globe.
   */
  function sunAngle(when: Date): number {
    const e = Ecliptic(HelioVector(Body.Earth, MakeTime(when)));
    return Math.atan2(e.vec.y, e.vec.x) + Math.PI;
  }

  function resize(): void {
    if (!canvas || !ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function draw(): void {
    if (!ctx || !canvas) return;

    const w = window.innerWidth;
    const h = window.innerHeight;
    ctx.clearRect(0, 0, w, h);

    const cx = w * CENTRE_X;
    const cy = h * CENTRE_Y;
    const r = h * RADIUS;

    const angle = sunAngle(dateOfDay(day));
    // The sub-solar point, pulled inside the limb so the gradient reads as a
    // sphere rather than a flat disc.
    const sx = cx + Math.cos(angle) * r * 0.55;
    const sy = cy + Math.sin(angle) * r * 0.55;

    // --- atmosphere, swept so it is brightest where the Sun strikes --------
    ctx.globalCompositeOperation = 'lighter';
    const step = (Math.PI * 2) / SEGMENTS;
    for (let i = 0; i < SEGMENTS; i++) {
      const a = i * step;
      // 1 facing the Sun, 0 on the night limb.
      const facing = Math.max(0, Math.cos(a - angle));
      const strength = facing ** 1.4;
      if (strength < 0.004) continue;

      const g = ctx.createRadialGradient(cx, cy, r * 0.985, cx, cy, r * 1.13);
      g.addColorStop(0, `rgba(120,190,255,${0.30 * strength})`);
      g.addColorStop(0.35, `rgba(90,160,255,${0.16 * strength})`);
      g.addColorStop(1, 'rgba(60,130,255,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, r * 1.13, a - step * 0.6, a + step * 0.6);
      ctx.arc(cx, cy, r * 0.985, a + step * 0.6, a - step * 0.6, true);
      ctx.closePath();
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';

    // --- the globe ---------------------------------------------------------
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.clip();

    const body = ctx.createRadialGradient(sx, sy, r * 0.04, cx, cy, r * 1.32);
    body.addColorStop(0, '#5E9FD4');
    body.addColorStop(0.18, '#3C77AE');
    body.addColorStop(0.38, '#23517F');
    body.addColorStop(0.58, '#12304F');
    body.addColorStop(0.76, '#0A1A2C');
    body.addColorStop(1, '#04080E');
    ctx.fillStyle = body;
    ctx.fillRect(cx - r, cy - r, r * 2, r * 2);

    // Light scattered forward through the atmosphere, hugging the lit limb.
    ctx.globalCompositeOperation = 'lighter';
    const inner = ctx.createRadialGradient(cx, cy, r * 0.90, cx, cy, r);
    inner.addColorStop(0, 'rgba(90,170,255,0)');
    inner.addColorStop(1, 'rgba(120,200,255,0.30)');
    ctx.fillStyle = inner;
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalCompositeOperation = 'source-over';

    ctx.restore();

    // --- the bright line on the sunward limb -------------------------------
    ctx.globalCompositeOperation = 'lighter';
    for (let i = 0; i < SEGMENTS; i++) {
      const a = i * step;
      const facing = Math.max(0, Math.cos(a - angle));
      const strength = facing ** 2.2;
      if (strength < 0.01) continue;
      ctx.strokeStyle = `rgba(175,225,255,${0.55 * strength})`;
      ctx.lineWidth = Math.max(1, r * 0.004);
      ctx.beginPath();
      ctx.arc(cx, cy, r * 0.997, a - step * 0.6, a + step * 0.6);
      ctx.stroke();
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  function setup(): void {
    canvas = document.querySelector<HTMLCanvasElement>('[data-earth]');
    if (!canvas) return;
    ctx = canvas.getContext('2d');
    if (!ctx) return;

    resize();
    draw();

    if (wired) return;
    wired = true;

    window.addEventListener('resize', () => { resize(); draw(); });
    document.addEventListener('timeline:day', (event) => {
      const next = (event as CustomEvent<{ day: number }>).detail?.day;
      if (typeof next !== 'number' || next === day) return;
      day = next;
      draw();
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
