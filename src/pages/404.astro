---
import Base from '../layouts/Base.astro';
---

<Base title="not found · yearofmax" description="this page doesn't exist.">
  <section class="notfound" data-hero>
    <p class="counter">404</p>
    <h1 class="heading">nothing here.</h1>
    <p class="measure">that page moved or never existed. the log is still where you left it.</p>
  </section>
</Base>

<style>
  .notfound {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .notfound h1,
  .notfound .measure {
    margin-top: 2rem;
  }
</style>
