---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/tools/ToolCard.astro';
import ColourCard from '../../components/tools/ColourCard.astro';
import { TOOLS } from '../../lib/tools';
---

<Base title="tools · yearofmax" description="">
  <section class="index">
    <h1 class="heading">tools</h1>

    {TOOLS.length > 0 ? (
      <ul class="cards">
        {TOOLS.map((tool) => (
          <ToolCard name={tool.name} summary={tool.summary} href={`/tools/${tool.slug}/`}>
            {tool.slug === 'colour' && <ColourCard />}
          </ToolCard>
        ))}
      </ul>
    ) : (
      <div class="empty" data-empty><p class="label"></p></div>
    )}
  </section>
</Base>

<style>
  .index {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .index h1 {
    margin-bottom: 2.5rem;
  }

  .empty {
    border-top: var(--hairline) solid var(--rule);
    padding: 1.75rem 0;
  }
</style>
