---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isRecent } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'projects'> };

const { entry } = Astro.props;
const { Content } = await render(entry);
const recent = isRecent(entry.data.date);

// Build-time check so a missing asset never renders as a broken image.
const { existsSync } = await import('node:fs');
const hasSplash = !!entry.data.splash && existsSync(`public${entry.data.splash}`);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="detail" class:list={{ 'is-recent': recent }}>
    <p class="detail__meta label">
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      <span class="detail__status">{entry.data.status}</span>
    </p>

    <h1 class="heading">{entry.data.title}</h1>
    <p class="detail__summary measure">{entry.data.summary}</p>

    {entry.data.url && (
      <p class="detail__url label">
        <a href={entry.data.url} rel="noopener noreferrer">{entry.data.url}</a>
      </p>
    )}

    {entry.data.tags.length > 0 && (
      <ul class="detail__tags">
        {entry.data.tags.map((tag) => <li class="label">{tag}</li>)}
      </ul>
    )}

    {hasSplash && (
      <figure class="detail__splash">
        <img src={entry.data.splash} alt="" loading="lazy" decoding="async" />
      </figure>
    )}

    <div class="prose measure"><Content /></div>
  </article>
</Base>

<style>
  .detail {
    padding-top: 3rem;
    padding-bottom: 5rem;
    border-top: var(--hairline) solid var(--rule);
  }

  .detail__meta {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .detail.is-recent .detail__meta {
    color: var(--signal);
  }

  .detail__summary {
    margin-top: 1.25rem;
    color: var(--graphite);
  }

  .detail__url {
    margin-top: 1.25rem;
  }

  .detail__url a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: var(--hairline);
    text-decoration-color: var(--rule);
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .detail__splash {
    margin: 3rem 0 0;
    background: var(--ink);
    overflow: hidden;
  }

  .detail__splash img {
    width: 100%;
    height: auto;
  }

  .prose {
    margin-top: 3rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-bottom: 1.4rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: var(--hairline);
    text-decoration-color: var(--rule);
  }

  .prose :global(ul) {
    list-style: none;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
  }
</style>
