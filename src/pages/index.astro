---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';

const DAY_MS = 86_400_000;
const now = new Date();
const year = now.getUTCFullYear();
const yearStart = Date.UTC(year, 0, 1);
const totalDays = Math.round((Date.UTC(year + 1, 0, 1) - yearStart) / DAY_MS);
const today = Date.UTC(year, now.getUTCMonth(), now.getUTCDate());
const dayOfYear = Math.round((today - yearStart) / DAY_MS) + 1;
---

<Base title="yearofmax" description="">
  <Timeline />

  <section class="hero">
    <p class="counter" data-counter>{dayOfYear}</p>
    <p class="label" data-counter-total>{totalDays}</p>
    <h1 class="heading"></h1>
    <p class="measure"></p>
  </section>
</Base>

<style>
  /* Above the timeline, which is fixed at z-index 0. */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: clamp(1.25rem, 4vh, 3rem);
    padding-bottom: clamp(1.5rem, 5vh, 4rem);
  }

  .hero h1,
  .hero .measure {
    margin-top: clamp(0.75rem, 2.5vh, 2rem);
  }
</style>

<script>
  const DAY_MS = 86_400_000;

  /** Static build: correct the build-time counter against the visitor's date. */
  function refresh(): void {
    const counter = document.querySelector<HTMLElement>('[data-counter]');
    const total = document.querySelector<HTMLElement>('[data-counter-total]');
    if (!counter) return;

    const now = new Date();
    const year = now.getUTCFullYear();
    const yearStart = Date.UTC(year, 0, 1);
    const totalDays = Math.round((Date.UTC(year + 1, 0, 1) - yearStart) / DAY_MS);
    const today = Date.UTC(year, now.getUTCMonth(), now.getUTCDate());

    counter.textContent = String(Math.round((today - yearStart) / DAY_MS) + 1);
    if (total) total.textContent = String(totalDays);
  }

  document.addEventListener('astro:page-load', refresh);
</script>
